<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- ===================================================== -->
    <!-- Spring Boot defaults                                  -->
    <!-- ===================================================== -->

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>


    <!-- ===================================================== -->
    <!-- Console Appender                                      -->
    <!-- ===================================================== -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>

            <pattern>
                %d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}
                [%thread]
                %-5level
                %logger{36}
                -
                %msg%n
            </pattern>

        </encoder>

    </appender>


    <!-- ===================================================== -->
    <!-- Fraud Service                                         -->
    <!-- ===================================================== -->

    <logger
            name="com.swiftpay.fraud"
            level="INFO"/>


    <!-- ===================================================== -->
    <!-- Kafka                                                  -->
    <!-- ===================================================== -->

    <logger
            name="org.springframework.kafka"
            level="INFO"/>


    <!-- ===================================================== -->
    <!-- Redis                                                  -->
    <!-- ===================================================== -->

    <logger
            name="org.springframework.data.redis"
            level="INFO"/>


    <!-- ===================================================== -->
    <!-- Hibernate SQL                                         -->
    <!-- ===================================================== -->

    <logger
            name="org.hibernate.SQL"
            level="WARN"/>

    <logger
            name="org.hibernate.orm.jdbc.bind"
            level="WARN"/>


    <!-- ===================================================== -->
    <!-- Root                                                   -->
    <!-- ===================================================== -->

    <root level="INFO">

        <appender-ref ref="CONSOLE"/>

    </root>

</configuration>